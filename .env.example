# Скопируйте в .env. Реальный .env в репозиторий не попадает.

# Пароль для входа в веб-интерфейс.
# Если не задать — сервер сгенерирует случайный при запуске и покажет в консоли.
AUTH_PASS=change_me

# Корневая папка, которой управляет менеджер (или куда смотрят виртуальные папки)
BASE_ROOT=D:\Work

# Виртуальные папки: Имя:путь,через,запятую
# MOUNTS=Docs:C:\Docs,Desktop:C:\Users\Me\Desktop

# Порт
PORT=47821

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=2048
